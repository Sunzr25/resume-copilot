# ============================================================
# Resume Copilot 配置文件
# 复制本文件为 .env.local 并填入你的API密钥
# ============================================================

# AI 模型配置
# 默认使用 KIMI API (Moonshot)，你也可以改为 openai 或 anthropic
AI_PROVIDER=openai

# ============================================================
# KIMI (Moonshot) API 配置 - 推荐使用
# https://platform.moonshot.cn/
# ============================================================
OPENAI_API_KEY=your-kimi-api-key-here
OPENAI_BASE_URL=https://api.moonshot.cn/v1
OPENAI_MODEL=moonshot-v1-8k

# 或使用 moonshot-v1-32k (更长的上下文，但更慢)
# OPENAI_MODEL=moonshot-v1-32k

# ============================================================
# 可选：OpenAI API 配置
# 如需使用 GPT-4，则设置 AI_PROVIDER=openai
# https://platform.openai.com/api-keys
# ============================================================
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o

# ============================================================
# 可选：Anthropic API 配置
# 如需使用 Claude，则设置 AI_PROVIDER=anthropic
# https://console.anthropic.com/
# ============================================================
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================
# 数据库配置
# SQLite 本地开发（推荐），无需额外配置
# PostgreSQL 生产环境可选
# ============================================================
DATABASE_URL=file:./prisma/dev.db

# ============================================================
# 应用配置
# ============================================================
NEXT_PUBLIC_APP_NAME=Resume Copilot
NODE_ENV=development

# ============================================================
# 招聘爬虫配置（可选）
# OpenClaw API 用于爬取招聘信息
# ============================================================
# OPENCLAW_API_KEY=your-openclaw-key-here
# OPENCLAW_API_URL=https://api.openclaw.com
