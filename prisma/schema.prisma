generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model MasterProfile {
  id        String   @id @default(cuid())
  name      String   @default("")
  email     String   @default("")
  phone     String   @default("")
  location  String   @default("")
  summary   String   @default("")
  skills    String   @default("[]") // JSON array of skill strings
  education String   @default("[]") // JSON array of education objects
  workExp   String   @default("[]") // JSON array of work experience objects
  projects  String   @default("[]") // JSON array of project objects
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Application {
  id            String   @id @default(cuid())
  targetCompany String
  targetRole    String
  jdText        String
  status        String   @default("PREPARING") // PREPARING | APPLIED | INTERVIEWING | CLOSED
  tailoredData  String   @default("{}") // JSON: generated tailored resume content
  interviewQA   String   @default("[]") // JSON: predicted interview Q&A
  notes         String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// OpenClaw爬虫数据：职位信息
model CrawledJob {
  id            String   @id @default(cuid())
  crawlTaskId   String   @default("") // OpenClaw任务ID
  company       String
  position      String
  location      String
  salary        String
  description   String   @default("")
  source        String   @default("boss") // boss | lagou | other
  sourceUrl     String   @default("")
  rawData       String   @default("{}") // 原始爬虫数据
  isActive      Boolean  @default(true) // 是否还有效
  crawledAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  // 关联的面经
  interviews    CrawledInterview[]
  
  // 用户喜欢记录
  userLikes     UserLike[]
  
  @@unique([source, sourceUrl])
}

// OpenClaw爬虫数据：面经信息
model CrawledInterview {
  id           String   @id @default(cuid())
  crawlTaskId  String   @default("")
  jobId        String
  job          CrawledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  
  company      String
  position     String
  question     String
  answer       String   @default("")
  difficulty   String   @default("medium") // easy | medium | hard
  frequency    Int      @default(1) // 1-5 frequency score
  source       String   @default("xiaohongshu") // xiaohongshu | zhihu | other
  sourceUrl    String   @default("")
  crawledAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// 用户对职位的like记录
model UserLike {
  id        String   @id @default(cuid())
  jobId     String
  job       CrawledJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  likedAt   DateTime @default(now())
  @@unique([jobId])
}

// 用户历史填写的技能
model SkillHistory {
  id        String   @id @default(cuid())
  skill     String
  usedCount Int      @default(1) // 使用次数
  lastUsed  DateTime @default(now())
  createdAt DateTime @default(now())
  @@unique([skill])
}
